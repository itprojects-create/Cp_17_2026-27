# =================================================================
# NovaByte Onboarding Agent - Backend Environment Configuration
# =================================================================

# --- LLM Provider Selection ---
# Primary provider; any call it fails (quota, rate limit, timeout) is retried on LLM_FALLBACK_PROVIDER.
# Options: nvidia (default), gemini (alias: google), openai, grok, anthropic, mock
LLM_PROVIDER=nvidia
LLM_FALLBACK_PROVIDER=gemini
# Seconds before a slow primary call gives up and hands off to the fallback
LLM_PRIMARY_TIMEOUT=60

# Primary Provider (NVIDIA API Catalog, OpenAI-compatible) - get a key at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Must be a catalog model ID (vendor/model). Other tested free-tier options:
#   nvidia/nemotron-3.5-bolt-e4b (fastest, smaller)   openai/gpt-oss-20b (slower, richer formatting)
# Reasoning models think before answering; keep off for faster chat replies
NVIDIA_ENABLE_THINKING=false

# Fallback Provider (Google Gemini)
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Optional Providers (Used only if LLM_PROVIDER is configured for them)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# GROK_API_KEY=your-grok-api-key-here
# GROK_MODEL=grok-3-latest
# GROK_BASE_URL=https://api.x.ai/v1
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Security & Authentication ---
JWT_SECRET_KEY=generate_a_random_secure_secret_key_here
PASSWORD_RESET_EXPIRE_MINUTES=30
INVITE_EXPIRE_HOURS=72
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Server & CORS ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email Notifications (SMTP) ---
# Mode: "mock" (writes HTML/text to sent_emails/) or "real" (sends live emails)
# Gmail: turn on 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD (spaces are fine).
# Other providers: use their SMTP host/port; port 465 uses SSL automatically.
# Test your settings: python scripts/send_test_email.py you@example.com
EMAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
# Sender shown to recipients; SMTP_FROM_EMAIL must be your account or a verified alias.
SMTP_FROM_NAME=NovaByte Onboarding
SMTP_FROM_EMAIL=
# Receives onboarding-completion reports; must be a real inbox in real mode.
HR_EMAIL=hr@novabyte.com

# --- External Tool Integrations (GitHub) ---
# Mode: "mock" (in-memory simulator) or "real" (live API)
GITHUB_MODE=mock
GITHUB_TOKEN=ghp_your-github-token

# --- RAG / Vector Store Settings ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
MOCK_LLM_ENABLED=false
