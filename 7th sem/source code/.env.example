# =================================================================
# NovaByte Developer Onboarding Agent - Environment Template
# =================================================================
# Copy this file to:
#   - backend/.env (for FastAPI backend)
#   - frontend/.env (for React frontend)

# --- LLM Provider Selection ---
# Primary provider, with Google Gemini taking over any call it fails
LLM_PROVIDER=nvidia
LLM_FALLBACK_PROVIDER=gemini
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ENABLE_THINKING=false
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Optional Providers (openai, grok, anthropic)
# OPENAI_API_KEY=sk-your-openai-key
# GROK_API_KEY=your-grok-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Security & Auth ---
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Backend Server Configuration ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email Settings ---
EMAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=NovaByte Onboarding
HR_EMAIL=hr@novabyte.com

# --- Integrations (GitHub) ---
GITHUB_MODE=mock
GITHUB_TOKEN=ghp_your-token

# --- Frontend Client Configuration ---
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
